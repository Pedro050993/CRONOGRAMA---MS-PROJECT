# ---------------------------------------------------------------------------
# Exemplo de configuracao. Copie para .env e preencha. NUNCA versione .env.
# Nenhum segredo real deve aparecer neste arquivo.
# ---------------------------------------------------------------------------

# Banco de dados
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cronograma?schema=public"

# API
API_PORT=3001
API_HOST=0.0.0.0
# Chave de assinatura do JWT. Gere com: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# Armazenamento de arquivos: "fs" (desenvolvimento) ou "s3" (producao)
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./storage-data
# S3 / MinIO — preencher apenas quando STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Validade das URLs temporarias de download, em segundos
SIGNED_URL_TTL_SECONDS=300

# Limites de upload
MAX_UPLOAD_BYTES=209715200
MAX_ZIP_ENTRIES=5000
MAX_ZIP_UNCOMPRESSED_BYTES=2147483648

# ---------------------------------------------------------------------------
# Worker de processamento documental (services/docproc)
# ---------------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2

# OCR — adaptador. Sem provedor configurado, regioes sem texto viram PENDENCIA
# explicita; o sistema NUNCA inventa o conteudo.
OCR_PROVIDER=none          # none | tesseract | azure | google
OCR_LANGUAGES=por+eng
OCR_ENDPOINT=
OCR_API_KEY=

# LLM — adaptador. Padrao "none": extracao apenas por regra deterministica.
LLM_PROVIDER=none          # none | anthropic | openai-compat
LLM_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=

# Conversao CAD (Fase 2). Sem isso, DWG/DXF ficam bloqueados com mensagem explicita.
CAD_CONVERTER=none         # none | oda | aps
ODA_CONVERTER_PATH=
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Derivacao de modelo 3D (Fase 3). Sem isso, NWD/NWC ficam bloqueados.
MODEL_DERIVER=none         # none | aps

# ---------------------------------------------------------------------------
# Somente para docker-compose
# ---------------------------------------------------------------------------
POSTGRES_USER=cronograma
POSTGRES_PASSWORD=
POSTGRES_DB=cronograma
DOCPROC_REPLICAS=1
# true instala tesseract na imagem do worker e habilita OCR local
WITH_OCR=false
